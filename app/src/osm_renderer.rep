// RemoteObjects source definition for the osm_renderer ("Map Viewer") app.
//
// The app is a thin replica, exactly like osm_app: it forwards operations to
// core modules over RemoteObjects. `map_*` ops go to the `osm_renderer` core
// (via its generic invoke_op); osm ops (regions/lookup/fetch/catalog/open/...)
// go to the `osm` core (via its invokeOpJson). QML calls invokeOp(name,
// argsJson) and parses the returned JSON.
class OsmRenderer
{
    // Renderer core version JSON.
    PROP(QString rendererVersion READWRITE)

    // Last operation result JSON.
    PROP(QString lastResult READWRITE)

    // Last error message (empty on success).
    PROP(QString lastErr READWRITE)

    // Invoke an operation by name with JSON arguments; returns the JSON result.
    // map_* ops are forwarded to the osm_renderer core; everything else to osm.
    SLOT(QString invokeOp(QString name, QString argsJson))
}
