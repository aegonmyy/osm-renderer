module osm_renderer_core {
  version "0.1.0"
  description "Raster map renderer core: parses an OSM region PBF into a spatial index and renders Web-Mercator PNG tiles on demand. Exposes a single generic invoke_op the osm_renderer app forwards map_* ops through (same pattern osm_app uses with osm's invokeOpJson)."
  method invoke_op(name: tstr, args: tstr) -> tstr
}
